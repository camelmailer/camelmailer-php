{
    "name": "camelmailer/camelmailer",
    "description": "Camelmailer PHP SDK — transactional email, nothing else.",
    "keywords": ["php", "camelmailer", "email", "transactional", "sdk", "api", "client"],
    "homepage": "https://camelmailer.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Camelmailer contributors",
            "homepage": "https://github.com/camelmailer/camelmailer-php/contributors"
        }
    ],
    "require": {
        "php": "^8.1.0",
        "guzzlehttp/guzzle": "^7.5|^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CamelMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CamelMailer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse",
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
